# Copy this file to .env.local for local testing. Never commit real keys or secrets.

# ERC 8004 discovery. These are optional. Blank BSC_RPC_URL uses the public default.
BSC_RPC_URL=
ERC8004_SCAN_BLOCKS=100000
ERC8004_FROM_BLOCK=
ERC8004_MAX_AGENTS=100
ERC8004_LOG_CHUNK=4000
ERC8004_MAX_SCAN_MS=8000
ERC8004_INDEXER_URL=https://8004scan.io/api/v1/agents/latest

# Live hire configuration. Keep the address and resource values blank until the
# deployment has been tested. The UI remains discovery only while these are blank.
NEXT_PUBLIC_HIRE_NETWORK=bsc-mainnet
NEXT_PUBLIC_ERC8183_CONTRACT_ADDRESS=
NEXT_PUBLIC_PAYMENT_TOKEN_ADDRESS=
NEXT_PUBLIC_X402_RESOURCE_URL=
NEXT_PUBLIC_X402_FACILITATOR_URL=
NEXT_PUBLIC_HIRE_COMBINED_SETTLEMENT=false

# Optional hire settings.
NEXT_PUBLIC_ERC8183_EVALUATOR_ADDRESS=
NEXT_PUBLIC_ERC8183_HOOK_ADDRESS=
NEXT_PUBLIC_BSC_RPC_URL=

# Compatibility aliases accepted by the adapters.
# NEXT_PUBLIC_ERC8183_PAYMENT_TOKEN_ADDRESS=
# NEXT_PUBLIC_X402_RESOURCE=
